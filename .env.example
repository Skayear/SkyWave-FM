# Copiar a .env (que está en .gitignore) y completar con valores reales.
ICECAST_SOURCE_PASSWORD=changeme
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=changeme
ICECAST_SERVER_HOST=localhost
# Puerto mapeado en el host (ver docker-compose.yml): el 8000 default de
# Icecast ya lo usa portainer en esta máquina, así que quedó en 8010.
ICECAST_SOURCE_PORT=8010

# --- Solo para levantar con Docker (issue #39, docker-compose.yml) ---

# IP a la que se atan los puertos publicados (Icecast 8010, web 8001).
# Sin definir, cae a 127.0.0.1 (nada expuesto, ni LAN ni tailnet). En el
# host real: la IP de la interfaz tailscale0 (`tailscale ip -4`), nunca
# 0.0.0.0 -- la decisión de CLAUDE.MD es acceso solo por Tailscale.
BIND_HOST=127.0.0.1

# Carpeta con tu música, montada solo lectura dentro del contenedor.
# Requerida por docker-compose.yml -- sin esto, `docker compose up` falla.
MUSIC_DIR=/home/pablo/Music

# Host/puerto que arma la URL del stream que abre el navegador (issue
# #39, ver web/app.py get_stream_url). Dentro de Docker, el mixer le
# habla a Icecast por ICECAST_SERVER_HOST=icecast (puerto interno,
# seteado en docker-compose.yml) -- estas dos son la IP/puerto público
# real, la misma que BIND_HOST + el puerto mapeado de Icecast.
ICECAST_PUBLIC_HOST=localhost
ICECAST_PUBLIC_PORT=8010
